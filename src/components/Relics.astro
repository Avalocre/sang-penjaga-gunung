---
import StaffLine from './StaffLine.astro';

const relics = [
  {
    n: '01', img: '/assets/relic-staff.jpg', alt: 'Tongkat gong kembar: dua piringan kuningan tergantung pada tonggak kayu, asap dupa mengepul',
    title: 'Tongkat Gong Kembar',
    mark: 'Penjaga sedang berpindah',
    bodyA: 'Dua piringan kuningan digantung pada tonggak kayu setinggi menara. Dari sela-selanya mengepul asap dupa. Ketika angin gunung menabuhnya, satu dentuman berarti ',
    bodyB: '; dua dentuman berarti ia berhenti.',
    fig: 'Tongkat pusaka, generasi kedua'
  },
  {
    n: '02', img: '/assets/relic-ornaments.jpg', alt: 'Rantai perunggu berkarat dengan liontin teratai dan liontin daun cemara',
    title: 'Kail-kail Kuningan',
    mark: 'orang yang kehilangan jalan pulang',
    bodyA: 'Sembilan belas kail kecil terjuntai dari jubah kabutnya. Setiap kail adalah satu janji yang pernah diikatkan padanya — oleh pemburu, oleh petani, oleh ',
    bodyB: '.',
    fig: 'Perhiasan janji, usia tak tercatat'
  },
  {
    n: '03', img: '/assets/relic-claws.jpg', alt: 'Tangan raksasa berkuku gelap menyentuh pucuk cemara dari balik kabut',
    title: 'Tangan yang Menahan Langit',
    mark: 'menyentuh pucuk pohon',
    bodyA: 'Kukunya merah gelap, lebih gelap dari arang. Ia tidak pernah mencakar. Ia hanya pernah ',
    bodyB: ', seolah memeriksa apakah hutan masih tumbuh.',
    fig: 'Terlihat sekali, dari tebing timur'
  }
];
---
<section class="relics" aria-label="Pusaka yang ia bawa">
  <StaffLine />
  <div class="section-head">
    <h2 data-reveal>Apa yang ia <em>bawa</em></h2>
    <p data-reveal style="--reveal-delay:.1s">Setiap benda di tubuhnya adalah pusaka. Tidak ada yang hiasan belaka.</p>
  </div>

  {relics.map((r, i) => (
    <article class:list={["relic", { "relic--flip": i % 2 === 1 }]}>
      <figure class="relic__media" data-reveal>
        <img src={r.img} alt={r.alt} loading="lazy" decoding="async">
      </figure>
      <div class="relic__text" data-reveal style="--reveal-delay:.12s">
        <span class="relic__no">Relik {r.n}</span>
        <h3>{r.title}</h3>
        <p>{r.bodyA}<span class="mark">{r.mark}</span>{r.bodyB}</p>
        <span class="relic__fig">{r.fig}</span>
      </div>
    </article>
  ))}
</section>

<style>
  .relics{
    padding:calc(var(--section-pad) * 0.35) var(--gutter) var(--section-pad);
    max-width:var(--content); margin-inline:auto;
  }
  .section-head{ margin-bottom:clamp(3rem,7vh,5rem); max-width:30rem }
  .section-head h2{
    font-family:var(--font-display); font-weight:300;
    font-size:clamp(2.6rem, 6.5vw, 5.6rem); line-height:1.02; letter-spacing:-0.01em;
  }
  .section-head h2 em{ font-style:italic; color:var(--color-sage) }
  .section-head p{ margin-top:1.2rem; color:var(--color-ink-dim) }

  .relic{
    display:grid; gap:2rem;
    align-items:center;
    padding:clamp(2.5rem,6vh,4.5rem) 0;
    border-top:1px solid var(--color-moss-dim);
  }
  .relic:last-child{ border-bottom:1px solid var(--color-moss-dim) }
  @media (min-width:48rem){
    .relic{ grid-template-columns:7fr 5fr; gap:clamp(2rem,5vw,5rem) }
    .relic--flip{ grid-template-columns:5fr 7fr }
    .relic--flip .relic__media{ order:2 }
  }
  .relic__media{ position:relative; overflow:hidden }
  .relic__media img{
    width:100%; aspect-ratio:4/3.4; object-fit:cover;
    filter:saturate(.88) brightness(.88) contrast(1.05);
    transform:scale(1.02);
    transition:transform .9s cubic-bezier(.22,.8,.24,1);
  }
  @media (max-width:47rem){
    .relic__media img{ aspect-ratio:4/4.8 }
  }
  .relic__media:hover img{ transform:scale(1.07) }
  .relic__media::after{
    content:""; position:absolute; inset:0;
    box-shadow:inset 0 0 0 1px rgba(201,207,208,.08);
    pointer-events:none;
  }
  .relic__no{
    font-size:.8rem; letter-spacing:.3em; text-transform:uppercase; color:var(--color-bronze);
  }
  .relic h3{
    font-family:var(--font-display); font-weight:400;
    font-size:clamp(1.6rem, 3vw, 2.4rem); margin:.6rem 0 1rem; line-height:1.15;
  }
  .relic p{ color:var(--color-ink-dim); max-width:44ch }
  .relic .mark{ color:var(--color-vermilion-hi); font-style:normal }
  .relic__fig{
    display:block; margin-top:1.4rem;
    font-size:.85rem; letter-spacing:.14em; color:var(--color-ink-dim);
  }
</style>
