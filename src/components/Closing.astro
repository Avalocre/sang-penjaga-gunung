---
---
<section class="closing relative min-h-[100svh] flex flex-col items-center justify-center text-center overflow-clip">
  <div class="closing__art absolute inset-0 -z-10 will-change-transform" data-parallax="-0.1" aria-hidden="true">
    <img src="/assets/env-altar-night.jpg" alt="" loading="lazy" decoding="async">
  </div>
  <div class="closing__scrim absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="closing__body relative" style="padding:var(--section-pad) var(--gutter)">
    <p class="closing__kicker" data-reveal>Kabut akan menjawab</p>
    <h2 class="closing__title" data-reveal style="--reveal-delay:.1s">Segera di <em>bioskop</em></h2>
    <p class="closing__sub" data-reveal style="--reveal-delay:.2s">Daftarkan alamat surelmu. Satu pesan sebelum pemutaran perdana, tidak lebih. Gunung tidak suka spam.</p>

    <form class="signup" id="signupForm" data-reveal style="--reveal-delay:.3s">
      <label class="sr-only" for="signupEmail">Alamat surel</label>
      <input id="signupEmail" name="email" type="email" required placeholder="nama@surel.kamu" autocomplete="email">
      <button type="submit">Kabari aku</button>
    </form>
    <p class="signup__done" id="signupDone" role="status" aria-live="polite" hidden>Tercatat. Kabut akan menemukanmu.</p>
  </div>

  <footer class="closing__credits" data-reveal style="--reveal-delay:.4s">
    <span>Sutradara <b>A. Wirawati</b></span>
    <span>Produser <b>Lembah Kabut Film</b></span>
    <span>Tata suara <b>Studio Ganda Gong</b></span>
    <span>Sinematografi <b>D. Anjasmara</b></span>
  </footer>
</section>

<script>
  const form = document.getElementById('signupForm') as HTMLFormElement;
  const done = document.getElementById('signupDone');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const email = (document.getElementById('signupEmail') as HTMLInputElement)?.value;
    form.setAttribute('hidden', '');
    if (done) {
      done.textContent = `Tercatat untuk ${email}. Kabut akan menemukanmu.`;
      done.removeAttribute('hidden');
    }
  });
</script>

<style>
  .closing__art img{
    width:100%; height:112%; object-fit:cover; object-position:center 40%;
    opacity:.5;
  }
  .closing__scrim{
    background:
      radial-gradient(ellipse at center 60%, transparent 0%, rgba(13,20,18,.72) 70%),
      linear-gradient(rgba(13,20,18,.85), rgba(13,20,18,.35) 45%, rgba(13,20,18,.92));
  }
  .closing__kicker{
    font-size:.8rem; letter-spacing:.32em; text-transform:uppercase;
    color:var(--color-bronze); margin-bottom:1.6rem;
  }
  .closing__title{
    font-family:var(--font-display); font-weight:300;
    font-size:clamp(2.8rem, 9vw, 7.5rem); line-height:1.02; letter-spacing:-0.01em;
  }
  .closing__title em{ font-style:italic; color:var(--color-vermilion-hi) }
  .closing__sub{
    margin:1.8rem auto 0; max-width:44ch; color:var(--color-ink-dim);
  }
  .signup{
    margin:2.6rem auto 0; max-width:30rem;
    display:flex; gap:0; align-items:stretch;
    border-bottom:1.5px solid var(--color-mist);
    transition:border-color .4s;
  }
  .signup:focus-within{ border-bottom-color:var(--color-vermilion-hi) }
  .signup input{
    flex:1; min-width:0; background:transparent; border:none; outline:none;
    color:var(--color-ink); font-family:var(--font-body); font-size:1.1rem;
    padding:.9rem .2rem;
  }
  .signup input::placeholder{ color:var(--color-ink-dim) }
  .signup button{
    background:transparent; border:none; cursor:pointer;
    color:var(--color-vermilion-hi);
    font-family:var(--font-display); font-style:italic; font-size:1.1rem;
    letter-spacing:.02em; padding:.9rem 0 .9rem 1.2rem;
    transition:letter-spacing .4s;
  }
  .signup button:hover{ letter-spacing:.08em }
  .signup__done{
    margin:2.6rem auto 0; font-family:var(--font-display); font-style:italic;
    font-size:1.3rem; color:var(--color-sage);
  }
  .closing__credits{
    position:absolute; bottom:0; left:0; right:0;
    padding:2rem var(--gutter);
    display:flex; flex-wrap:wrap; justify-content:center; gap:.6rem 2.4rem;
    font-size:.78rem; letter-spacing:.16em; text-transform:uppercase;
    color:var(--color-ink-dim);
  }
  .closing__credits b{ font-weight:500; color:var(--color-mist); margin-left:.5em }
  .sr-only{
    position:absolute; width:1px; height:1px; overflow:hidden;
    clip:rect(0 0 0 0); white-space:nowrap;
  }
</style>
