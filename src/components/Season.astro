---
const months = [
  { m: 'Jan', fog: 5, crowd: 2 }, { m: 'Feb', fog: 4, crowd: 2 },
  { m: 'Mar', fog: 3, crowd: 3 }, { m: 'Apr', fog: 2, crowd: 3 },
  { m: 'Mei', fog: 1, crowd: 4 }, { m: 'Jun', fog: 1, crowd: 5 },
  { m: 'Jul', fog: 1, crowd: 5 }, { m: 'Agu', fog: 2, crowd: 4 },
  { m: 'Sep', fog: 3, crowd: 3 }, { m: 'Okt', fog: 4, crowd: 3 },
  { m: 'Nov', fog: 5, crowd: 2 }, { m: 'Des', fog: 5, crowd: 3 }
];
const itinerary = [
  { t: '03.30', w: 'Bangun di dusun kaki gunung. Minum jahe, jangan bicara keras.' },
  { t: '04.15', w: 'Lewat gerbang bambu. Kaki kabut mulai dari sini.' },
  { t: '05.40', w: 'Hutan kail. Telinga akan mendengar kuningan; kaki jangan berhenti.' },
  { t: '07.10', w: 'Tebing dua sosok. Matahari terbit di belakangmu — itu tandanya.' },
  { t: '08.00', w: 'Altar lentera. Nyalakan, duduk, tunggu kabut menjawab.' }
];
---
<section class="season" aria-label="Musim dan waktu">
  <div class="season__inner">
    <div class="section-head">
      <h2 data-reveal>Musim &amp; <em>waktu</em></h2>
      <p data-reveal style="--reveal-delay:.1s">Ia paling sering terlihat ketika kabut paling tebal — bulan-bulan basah, jam-jam sebelum fajar.</p>
    </div>

    <div class="fog-grid" role="table" aria-label="Ketebalan kabut dan keramaian per bulan">
      <div class="fog-grid__row fog-grid__row--head" role="row">
        <span role="columnheader"></span>
        {months.map(x => <span role="columnheader">{x.m}</span>)}
      </div>
      <div class="fog-grid__row" role="row">
        <span role="rowheader">Kabut</span>
        {months.map((x, i) => (
          <i role="cell" data-fog={x.fog} title={`${x.m}: kabut ${x.fog}/5`} data-reveal style={`--reveal-delay:${i * 0.03}s`}></i>
        ))}
      </div>
      <div class="fog-grid__row" role="row">
        <span role="rowheader">Pengunjung</span>
        {months.map((x, i) => (
          <i role="cell" data-crowd={x.crowd} title={`${x.m}: peziarah ${x.crowd}/5`} data-reveal style={`--reveal-delay:${i * 0.03 + 0.15}s`}></i>
        ))}
      </div>
      <p class="fog-grid__note" data-reveal>Bulan terbaik: <strong>November–Februari</strong>. Kabut penuh, jalanan sepi.</p>
    </div>

    <div class="itinerary">
      <h3 data-reveal>Satu pagi yang benar</h3>
      <ol>
        {itinerary.map((x, i) => (
          <li data-reveal style={`--reveal-delay:${i * 0.07}s`}>
            <time>{x.t}</time><span>{x.w}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .season{
    padding:var(--section-pad) var(--gutter);
    max-width:var(--content); margin-inline:auto;
  }
  .section-head{ margin-bottom:clamp(2.5rem,6vh,4rem); max-width:32rem }
  .section-head h2{
    font-family:var(--font-display); font-weight:300;
    font-size:clamp(2.6rem, 6.5vw, 5.6rem); line-height:1.02; letter-spacing:-0.01em;
  }
  .section-head h2 em{ font-style:italic; color:var(--color-sage) }
  .section-head p{ margin-top:1.2rem; color:var(--color-ink-dim) }

  /* fog grid */
  .fog-grid__row{
    display:grid;
    grid-template-columns:6.5rem repeat(12, 1fr);
    gap:4px; align-items:center;
    margin-bottom:6px;
  }
  .fog-grid__row--head span{
    font-size:.68rem; letter-spacing:.08em; text-transform:uppercase;
    color:var(--color-ink-dim); text-align:center;
  }
  .fog-grid__row [role="rowheader"]{
    font-size:.8rem; letter-spacing:.1em; text-transform:uppercase; color:var(--color-sage);
    white-space:nowrap;
  }
  .fog-grid__row i{
    height:1.9rem; display:block; background:var(--color-moss-dim);
    transition:transform .5s;
  }
  .fog-grid__row i:hover{ transform:scaleY(1.25) }
  .fog-grid__row i[data-fog="1"]{ background:color-mix(in srgb, var(--color-mist) 18%, var(--color-moss-dim)) }
  .fog-grid__row i[data-fog="2"]{ background:color-mix(in srgb, var(--color-mist) 34%, var(--color-moss-dim)) }
  .fog-grid__row i[data-fog="3"]{ background:color-mix(in srgb, var(--color-mist) 50%, var(--color-moss-dim)) }
  .fog-grid__row i[data-fog="4"]{ background:color-mix(in srgb, var(--color-mist) 68%, var(--color-moss-dim)) }
  .fog-grid__row i[data-fog="5"]{ background:var(--color-mist) }
  .fog-grid__row i[data-crowd="2"]{ background:color-mix(in srgb, var(--color-vermilion) 30%, var(--color-moss-dim)) }
  .fog-grid__row i[data-crowd="3"]{ background:color-mix(in srgb, var(--color-vermilion) 55%, var(--color-moss-dim)) }
  .fog-grid__row i[data-crowd="4"]{ background:color-mix(in srgb, var(--color-vermilion) 78%, var(--color-moss-dim)) }
  .fog-grid__row i[data-crowd="5"]{ background:var(--color-vermilion) }
  .fog-grid__note{
    margin-top:1.6rem; font-size:.95rem; color:var(--color-ink-dim);
  }
  .fog-grid__note strong{ color:var(--color-ink); font-weight:500 }

  /* itinerary */
  .itinerary{ margin-top:clamp(4rem,9vh,6.5rem); max-width:44rem }
  .itinerary h3{
    font-family:var(--font-display); font-weight:400;
    font-size:clamp(1.6rem,3vw,2.2rem); margin-bottom:2rem;
  }
  .itinerary ol{ list-style:none; padding:0; border-left:1px solid var(--color-moss-dim) }
  .itinerary li{
    display:grid; grid-template-columns:4.5rem 1fr; gap:1.5rem;
    padding:1.1rem 0 1.1rem 1.8rem; position:relative;
  }
  .itinerary li::before{
    content:""; position:absolute; left:-4px; top:1.55rem;
    width:7px; height:7px; border-radius:50%;
    background:var(--color-bronze);
  }
  .itinerary time{
    font-family:var(--font-display); font-style:italic; color:var(--color-bronze);
    font-size:1.05rem;
  }
  .itinerary li span{ color:var(--color-ink-dim) }
</style>
