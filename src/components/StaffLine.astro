---
interface Props { in?: boolean }
const { in: isIn = false } = Astro.props;
---
<div class:list={["staff-line", { "staff-line--in": isIn }]} aria-hidden="true"></div>

<style>
  .staff-line{
    width:1px; height:clamp(3.5rem,11vh,7rem);
    background:linear-gradient(var(--color-bronze), transparent);
    margin-inline:auto;
    position:relative;
  }
  .staff-line::before{
    content:""; position:absolute; top:-5px; left:50%; transform:translateX(-50%);
    width:11px; height:11px; border-radius:50%;
    border:1.5px solid var(--color-bronze);
  }
  .staff-line--in{ background:linear-gradient(transparent, var(--color-bronze)) }
  .staff-line--in::before{ top:auto; bottom:-5px }
</style>
